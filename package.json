{
  "name": "household",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware",
    "fallow": "fallow audit",
    "db:check": "node scripts/drizzle.ts check",
    "db:generate": "node scripts/drizzle.ts generate",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev": "node scripts/dev.ts",
    "seed": "node scripts/seed.ts",
    "start": "node server/main.ts",
    "build:web": "cd web && vite build",
    "dev:web": "cd web && vite dev",
    "person": "node scripts/person.ts",
    "check:full": "node scripts/check.ts --full",
    "env:init": "node scripts/env-init.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/provider": "4.0.35",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@date-fns/tz": "^1.5.0",
    "@dbos-inc/dbos-sdk": "5.4.0",
    "@hono/node-server": "^2.1.5",
    "@household/contracts": "workspace:*",
    "@mastra/core": "1.81.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@trpc/client": "11.22.1",
    "@trpc/server": "11.22.1",
    "@trpc/tanstack-react-query": "11.22.1",
    "@vectorize-io/hindsight-client": "1.1.0",
    "ai": "7.0.159",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embedded-postgres": "18.6.0-beta.19",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "suncalc": "^2.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.63.0",
    "@tanstack/react-start": "1.169.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.11",
    "fallow": "3.38.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }

# The real house. Run `pnpm env:init --real` on the server: it writes .env with every secret generated at
# random. Then fill in the credentials below that it leaves empty. Never commit .env.
PRACTICE=false
DB_PREFIX=home
PUBLIC_URL=https://house.example.com
SESSION_SECRET=

# PLT-9: the AI provider is a setting.
MODEL_PROVIDER=anthropic
MODEL_ID=claude-opus-5-5
ANTHROPIC_API_KEY=

# Object storage (SeaweedFS in compose) and the key objects are encrypted with (keep a copy elsewhere).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_KEY=

# The sealed helper: the server only knows its token; the Waitrose login lives in SUPERMARKET_SECRET_FILE.
HELPER_TOKEN=
SUPERMARKET_SECRET_FILE=./.secrets/waitrose.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
CALENDAR_WEBHOOK_TOKEN=
MCP_TOKEN=
# Google Calendar, read-only (docs/OPERATIONS.md, "Google Calendar"): each calendar the house reads
# with its owner (a person's ID, or `shared`), IDs from `sudo household-google check`, e.g.
# GOOGLE_CALENDARS=cal:cal@gmail.com,chloe:chloe@gmail.com,shared:abc123@group.calendar.google.com
# (GOOGLE_CALENDAR_ID alone still works: the shared calendar only), and the file `pnpm google:connect`
# wrote, by its path in the container.
GOOGLE_CALENDARS=
GOOGLE_CALENDAR_ID=
GOOGLE_ACCESS_TOKEN_FILE=/run/household-credentials/google.json
HINDSIGHT_URL=

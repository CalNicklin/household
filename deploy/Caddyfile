# PLT-8 / PRV-6: the only way in from the internet. Caddy gets and renews the certificate for
# HOUSEHOLD_DOMAIN itself; the app behind it asks for a login for everything but /healthz.
{
	admin off
	# FB-5: a preview's certificate is got when it is first visited, and only if Caddyfile.previews says
	# that preview is running. Unused while there are no previews.
	on_demand_tls {
		ask http://127.0.0.1:5555/
	}
}

{$HOUSEHOLD_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy app:3001
}

# FB-5: the PR previews' sites, present only when install.sh was given --preview-domain.
import /etc/caddy/previews/*.caddy
# HOU-150: the mail receiver's host name (for its certificate), present only with --mail-domain.
import /etc/caddy/mail/*.caddy

        "patterns": [
          "server/domains/shopping/**"
        ]
      },
      {
        "name": "domain-lists",
        "patterns": [
          "server/domains/lists/**"
        ]
      },
      {
        "name": "rules",
        "patterns": [
          "server/rules/**"
        ]
      },
      {
        "name": "planner",
        "patterns": [
          "server/planner/**"

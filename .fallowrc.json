{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "helper/main.ts",
    "mail/main.ts",
    "mail/last-confirmation.ts",
    "practice/supermarket/main.ts",
    "scripts/*.ts",
    "web/src/router.tsx",
    "web/src/routes/**/*.tsx",
    "web/vite.config.ts",
    "tools/**/*.ts",
    "tools/oxlint-plugin/index.js",
    "server/domains/*/drizzle.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "dynamicallyLoaded": [
    "server/adapters/*/index.ts",
    "helper/tasks/*/index.ts",
    "web/public/sw.js",
    "web/src/design-system/*.css"
  ],
  "ignorePatterns": [
    "design/**",
    ".data/**",
    "web/src/routeTree.gen.ts"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-class-members": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "unresolved-imports": "error",
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn",
    "complexity-file-lines": "warn",
    "policy-violation": "off"
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "**/*.test.ts",
          "**/*.test.tsx"
        ]
      },
      {
        "name": "contracts",
        "patterns": [
          "contracts/**"
        ]
      },
      {
        "name": "infra",
        "patterns": [
          "server/db/**",
          "server/trpc.ts",
          "server/live/**",
          "server/env.ts",
          "server/ports.ts",
          "server/time.ts"
        ]
      },
      {
        "name": "domain-household",
        "patterns": [
          "server/domains/household/**"
        ]
      },
      {
        "name": "domain-calendar",
        "patterns": [
          "server/domains/calendar/**"
        ]
      },
      {
        "name": "domain-backlog",
